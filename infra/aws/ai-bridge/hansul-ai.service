[Unit]
Description=Hansul private Responses bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/hansul-ai
EnvironmentFile=/etc/hansul-ai.env
ExecStart=/usr/bin/python3 /home/ec2-user/hansul-ai/responses_bridge.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
