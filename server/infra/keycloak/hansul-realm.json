{
  "realm": "hansul",
  "enabled": true,
  "displayName": "한술 Local",
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "한술 앱 사용자"
      }
    ]
  },
  "clients": [
    {
      "clientId": "hansul-api",
      "name": "한술 API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "hansul-android",
      "name": "한술 Android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "hansul://oauth/callback",
        "com.hansul.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "hansul://oauth/logout##com.hansul.app:/oauth2redirect"
      },
      "protocolMappers": [
        {
          "name": "hansul-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hansul-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hansul-smoke",
      "name": "한술 Local Smoke Test",
      "description": "로컬 개발 및 자동 smoke 전용. 배포 환경에는 생성하지 않습니다.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "hansul-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hansul-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "dev-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "한술",
      "lastName": "개발자",
      "email": "dev-user@hansul.local",
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ]
    }
  ]
}
